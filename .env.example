# InstantDB 앱 ID — instantdb.com/dash 에서 발급
NEXT_PUBLIC_INSTANT_APP_ID=

# admin 페이지 비밀번호 (클라이언트 번들에 포함됨 — 학내망 전용 가정)
NEXT_PUBLIC_ADMIN_PASSWORD=

# Ollama Cloud API 키 — ollama.com 에서 발급. 서버 사이드 전용.
# NEXT_PUBLIC_ 접두사 절대 사용 금지 (클라이언트 노출됨).
OLLAMA_API_KEY=

# 요약에 사용할 Ollama Cloud 모델. 기본값 gpt-oss:120b.
# 가능한 값은 https://ollama.com/search?c=cloud 참조.
OLLAMA_MODEL=gpt-oss:120b

# ── 디스코드 공지 연동 (선택) ─────────────────────────────────────────
# 전부 서버 사이드 전용. NEXT_PUBLIC_ 접두사 절대 금지 (토큰 유출 = 봇 권한 전체 유출).
# 토큰이 비어 있으면 연동이 꺼진 상태로 앱은 정상 동작한다.
# 발급: https://discord.com/developers/applications → Bot → Reset Token
DISCORD_BOT_TOKEN=
# 대상별 공지 채널 ID (개발자 모드 → 채널 우클릭 → ID 복사). 비워둔 대상은 발송 안 함.
# 채널은 1·2·3·4학년 + 전체, 총 5개. "전체" 는 학년의 합집합이 아니라 대등한 5번째 대상이라
# 전체를 고른 공지만 ALL 채널로 간다 (1학년 공지는 Y1 에만 감).
DISCORD_CHANNEL_Y1=
DISCORD_CHANNEL_Y2=
DISCORD_CHANNEL_Y3=
DISCORD_CHANNEL_Y4=
DISCORD_CHANNEL_ALL=
# 채널별 멘션 (선택). 게시할 때 해당 채널 메시지 맨 앞에 붙는다. 값은 셋 중 하나:
#   역할 ID (역할 우클릭 → ID 복사)  /  everyone  /  here
# 학년별 채널에 학년 역할이 따로 있으면 그 역할 ID 를 넣으면 된다.
# 전체 채널은 보통 everyone 이 적절하다.
DISCORD_MENTION_Y1=
DISCORD_MENTION_Y2=
DISCORD_MENTION_Y3=
DISCORD_MENTION_Y4=
DISCORD_MENTION_ALL=
# 테스트 채널. 어드민에서 대상 "테스트" 를 고른 공지만 여기로 간다 (학년/전체와 대등한 6번째 대상).
# 테스트 공지는 디스플레이·위젯엔 노출되지 않는다.
DISCORD_CHANNEL_TEST=
# 테스트 채널 멘션 (선택). 비워두는 걸 권장 — 테스트하다 @everyone 울리는 사고 방지.
DISCORD_MENTION_TEST=

# 운세/포춘쿠키 전용 모델. 미설정 시 gemma4:31b.
# 요약과 분리돼 있으므로 OLLAMA_MODEL 을 바꿔도 영향받지 않는다.
# 반드시 Ollama Cloud 가 서빙하는 태그여야 한다 (ollama.com/search?c=cloud).
# 로컬 pull 전용 태그(gemma4:12b, gemma3:4b 등)를 넣으면 410 Gone 이 난다.
OLLAMA_FORTUNE_MODEL=
OLLAMA_COOKIE_MODEL=
